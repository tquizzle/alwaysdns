# Copy this file to dnsui.env and adjust. Keep it out of version control:
#   chmod 600 dnsui.env
#
# First start: if no admin password hash is set here and the data volume is
# empty, the server creates the "admin" account with a random password and
# prints it once. Read it with: docker compose logs dnsui
#
# To set your own password instead, generate a hash with
#   docker compose run --rm -it dnsui hash-password
# and set DNSUI_ADMIN_PASSWORD_HASH below (wrap it in single quotes).

DNSUI_ADMIN_USER=admin
# DNSUI_ADMIN_PASSWORD_HASH='paste-hash-here'

# Optional read-only viewer account. Uncomment both lines to enable it.
# DNSUI_VIEWER_USER=viewer
# DNSUI_VIEWER_PASSWORD_HASH='replace-with-output-of-hash-password'

# Optional AdGuard Home integration. Leave these commented out if unused.
# ADGUARD_URL=http://adguard-host.example:3000
# ADGUARD_USER=replace-with-adguard-user
# ADGUARD_PASSWORD=replace-with-adguard-password

# Optional. Selects where dashboard statistics come from.
# STATS_SOURCE=replace-with-source-name
